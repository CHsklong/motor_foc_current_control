<!DOCTYPE CrossStudio_Project_File>
<solution Name="bldc_foc" target="20" version="2">
  <project Name="bldc_foc - hpm6750evkmini">
    <configuration
      Name="Common"
      LIBRARY_IO_TYPE="STD"
      arm_linker_heap_size="0x4000"
      arm_linker_stack_size="0x4000"
      arm_rtl_variant="SEGGER"
      arm_linker_no_warn_on_mismatch="Yes"
      build_generic_options_file_name=""
      c_user_include_directories="../../../../../arch;../../../../../arch/riscv/l1c;../../../../../arch/riscv/intc;../../../../../boards/hpm6750evkmini;../../../../../soc/HPM6700/HPM6750;../../../../../soc/HPM6700/ip;../../../../../soc/HPM6700/HPM6750/toolchains;../../../../../soc/HPM6700/HPM6750/boot;../../../../../drivers/inc;../../../../../utils;../../../../../components/debug_console;../../../../../components/adc_v2;../../../../../middleware/hpm_mcl_v2;../../../../../middleware/hpm_mcl_v2/encoder;../../../../../middleware/hpm_mcl_v2/drivers;../../../../../middleware/hpm_mcl_v2/core/sensor;../../../../../middleware/hpm_mcl_v2/core/drivers;../../../../../middleware/hpm_mcl_v2/core/loop;../../../../../middleware/hpm_mcl_v2/core/detect;../../../../../middleware/hpm_mcl_v2/core/control;../build_tmp/generated/include;../../src;"
      link_linker_script_file="..\..\..\..\..\soc\HPM6700\HPM6750\toolchains\segger\flash_xip.icf"
      link_use_linker_script_file="Yes"
      linker_output_format="hex"
      project_directory=""
      project_type="Executable"
      debug_target_connection="GDB Server"
      gdb_server_type="Custom"
      gdb_server_reset_command="reset halt"
      gdb_server_autostart_server="Yes"
      gdb_server_port="3333"
      gdb_server_command_line="D:/sdk_env_v1.12.1/tools/openocd/openocd.exe -f $(ProjectDir)/../../../../../boards/openocd/probes/ft2232.cfg -f $(ProjectDir)/../../../../../boards/openocd/soc/hpm6750-dual-core.cfg -f $(ProjectDir)/../../../../../boards/openocd/boards/hpm6750evkmini.cfg"
      target_device_name="HPM6750xVMx"
      linker_output_format="bin"
      post_build_command="&quot;$(OBJDUMP)&quot; -S -d &quot;$(OutDir)/demo$(EXE)&quot; &gt; &quot;$(OutDir)/demo.asm&quot;"
      heap_size="0x4000"
      stack_size="0x4000"
      RISCV_TOOLCHAIN_VARIANT="Standard"
      rv_abi="ilp32f"
      rv_architecture="rv32imafc"
      c_additional_options="-Wall;-Wundef;-Wno-format;-fomit-frame-pointer;-fno-builtin;-ffunction-sections;-fdata-sections;-g"
      rv_arch_ext=""
      rv_arch_zicsr="No"
      rv_arch_zifencei="Yes"
      rv_debug_extensions="None"
      rv_toolchain_prefix=""
      gcc_cplusplus_language_standard="c++11"
      libcxx="Yes"
      build_output_file_name="$(OutDir)/demo$(EXE)"
      linker_printf_fp_enabled="Float"
      linker_printf_fmt_level="int"
      linker_printf_wchar_enabled="No"
      linker_printf_width_precision_supported="Yes"
      linker_scanf_fp_enabled="No"
      linker_scanf_fmt_level="int"
      linker_scanf_character_group_matching_enabled="No"
      gcc_enable_all_warnings="Yes"
      gcc_all_warnings_command_line_options="-Wall;-Wextra;-Wno-format"
      arm_compiler_variant="gcc"
      arm_assembler_variant="SEGGER"
      arm_linker_variant="SEGGER"
      />

